{
  "version": 3,
  "timezone": "Europe/Madrid",
  "mode": "vod_only",
  "content_policy": {
    "require_authorization": true,
    "require_transformative_edit": true,
    "allow_unlicensed_reposting": false
  },
  "limits": {
    "max_candidates_per_run": 20,
    "max_publish_attempts": 3,
    "max_clip_duration_seconds": 58.5,
    "min_clip_duration_seconds": 15
  },
  "sources": {
    "primary": ["twitch_vods"],
    "secondary": ["kick_vods_when_officially_available"]
  },
  "live_processing": {
    "enabled": false
  }
}
